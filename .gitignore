.DS_Store
# macOS custom-folder-icon resource (a file literally named "Icon" + CR).
Icon?

# Obsidian's local trash (soft-deleted notes/attachments) — not currently
# created, but not excluded either; deleted content shouldn't get committed.
.trash/

# Agent-scratch append-log payloads. wiki-enhancer/wiki-cos write a temp JSON
# entry then call `wiki.py append-log --from-json`; agents sometimes write it
# in-tree instead of /tmp/ and leave .bak/.done renames behind. The agent prompt
# now mandates an absolute /tmp/ path; these patterns are the belt-and-braces.
*.json.bak
*.json.done
wiki-log-*.json

# Private, separately versioned adapter for this live Brain instance. The public
# VaultLens skeleton exposes the shared implementation but never owns this tree.
.brain-local/

# The container launcher is retired and nothing in the repo uses .devcontainer/.
# Kept ignored so leftover operator-local files there (mount roots, launchers,
# iCloud conflict copies) are never committed to the public repo.
.devcontainer/

# Agent config: track canonical AGENTS.md/.agents/, generated provider adapters,
# and shared settings. Only machine-local Claude state stays ignored.
.claude/settings.local.json
.claude/worktrees/
.ruff_cache
__pycache__
# Machine-local provider preference; shared code remains provider-neutral.
tools/llm.local.json
tools/host-repair-backups/
tools/access.local.json
tools/runtime-node/
tools/runtime-state/
tools/runtime/migration/

# Obsidian: ignore workspace state and personal UI preferences. Carve out
# scaffold-relevant plugin settings (Templater folder templates) so they
# travel with the skeleton repo. Add more plugin data.json files here if
# their settings become part of the scaffold.
.obsidian/*
!.obsidian/plugins/
.obsidian/plugins/*
!.obsidian/plugins/templater-obsidian/
.obsidian/plugins/templater-obsidian/*
!.obsidian/plugins/templater-obsidian/data.json

# Raw material belongs to the local Brain, not the public skeleton. Ignore every
# present and future raw payload while retaining the fixed directory scaffold.
raw/*
!raw/.gitkeep
!raw/sources/
raw/sources/*
!raw/sources/.gitkeep
!raw/sources-text/
raw/sources-text/*
!raw/sources-text/.gitkeep
!raw/assets/
raw/assets/*
!raw/assets/.gitkeep
!raw/inbox/
raw/inbox/*
!raw/inbox/.gitkeep
!raw/review-inbox/
raw/review-inbox/*
!raw/review-inbox/.gitkeep
wiki/comparisons/*
wiki/concepts/*
wiki/entities/*
wiki/inventory/*
wiki/queries/*
wiki/reports/*
wiki/sources/*
wiki/syntheses/*
wiki/topics/*
wiki/log.md
wiki/log/*
!wiki/log/.gitkeep
wiki/index.md

# Derived CLI-readable indexes (`wiki.py index --rebuild`). Per-category
# `_index.md` files are already covered by the `wiki/<cat>/*` rules above; these
# two are the only derived indexes outside an ignored category. They aggregate
# counts from the (gitignored) content, so tracking them leaks the private
# brain's size and shape into the scaffold. Regenerate locally after cloning.
wiki/_index.md
wiki/system/_index.md

projects/*/
!.gitkeep

# Generated TODO aggregators (live `TODO.md` + iOS `TODO-widget.md`), rebuilt per
# device by tools/scripts/rebuild-projects-todo.sh. Device-local task tracking,
# not version-controlled. (Per-project projects/<slug>/TODO.md are ignored above
# via `projects/*/`.)
projects/TODO*.md
# Live deadline queries contain one generated exclusion per frozen local
# project. Keep the reusable query in deadlines.template.md; never publish the
# rendered local view.
projects/deadlines.md
